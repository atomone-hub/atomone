# Copy to .env (same directory, gitignored) or export in your shell.
# Environment variables already set win over this file.
# Values below are dummies; PROVER_ADDR has no default and is required.

# Groth16 prover endpoint, host:port only, no http:// (required).
# CI: configure it as the SPECTRE_PROVER_ADDR repository variable, or pass it
# as a workflow_dispatch input; it is intentionally not hardcoded in the repo.
PROVER_ADDR=prover.example.invalid:50060

# spectre checkout under test.
SPECTRE_REPO=https://github.com/decentrio/spectre-pubblic
SPECTRE_REF=fc576a4

# Optional overrides.
#ATOMONED=/path/to/atomoned
#SPECTRE_DIR=/path/to/spectre
#WORK=/tmp/atomone-devnet
